# === AgentForge AI Environment Variables ===

# Database (leave empty for SQLite fallback in development)
DATABASE_URL=postgresql://agentforge:agentforge_dev@localhost:5432/agentforge_db

# ─── AI Provider (set at least ONE key for real output) ───
# Recommended for a free live demo: Groq has a generous free tier + fast Llama 3.3.
# Get a free key at https://console.groq.com  → paste below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternatives (auto-selected if Groq is absent):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Which provider to use: groq | gemini | claude | ollama | auto (auto = first key found, else local Ollama)
AI_PROVIDER=auto

# Local model (free, offline): install https://ollama.com, run `ollama pull qwen2.5:3b`, set AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Mock Mode — DEMO data only. Default is FALSE so a real LLM is used.
# If left false but no API key is set, agents fall back to simulated data
# which the UI clearly labels with a "DEMO DATA" badge. Set true to force it.
MOCK_MODE=false

# Agents that run generate -> self-critique -> refine (each adds 2 LLM calls).
# Comma-separated: ceo,research,marketing,developer,finance,analytics,operations
SELF_CRITIQUE_AGENTS=ceo

# Brave Search API (optional — keyless Wikipedia search is used if not set)
BRAVE_SEARCH_API_KEY=

# JWT Auth (auto-generated per-session in development if left as default)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS (frontend origin)
FRONTEND_URL=http://localhost:5173

# Deployment environment: development | production
# production REQUIRES a real JWT_SECRET_KEY and an AI API key (no auto-fallback).
ENVIRONMENT=development
